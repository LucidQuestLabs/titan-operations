# Local read-only source import. Never configure this path in Netlify.
TITAN_RC0_WORKBOOK_PATH=C:\path\to\authorized\2025 Work Schedule 123.xlsx

# Local/session secret used to generate Masked Demo presentation data.
# Never commit the real value or expose it through a VITE_* variable.
TITAN_RC0_MASK_KEY=replace-with-session-secret

# Optional manifest timestamp override for a controlled generation run.
TITAN_RC0_GENERATED_AT=2026-08-19T00:00:00.000Z
